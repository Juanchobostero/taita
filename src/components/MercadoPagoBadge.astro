---
// Insignia liviana "estilo Mercado Pago" (ícono de tarjeta + wordmark) — no es el logo oficial de
// la marca (no tenemos el asset embebido en el repo y no correspondía inventar una URL externa
// para hotlinkearlo), pero usa los mismos colores de marca y comunica "pagado/pagar con Mercado
// Pago" de un vistazo. Si en algún momento se consigue el logo oficial, reemplazar acá nomás — se
// usa desde el botón de pago del cliente y de todos los lugares que muestran el estado "pagado".
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<span class={`inline-flex items-center gap-1.5 ${className}`}>
  <svg width="16" height="16" viewBox="0 0 24 24" class="shrink-0">
    <rect x="1" y="5" width="22" height="14" rx="3" fill="#00B1EA" />
    <rect x="1" y="8.5" width="22" height="3" fill="#0A2540" />
    <rect x="4" y="14.5" width="7" height="2" rx="1" fill="#fff" />
  </svg>
  <span class="font-semibold">Mercado Pago</span>
</span>
