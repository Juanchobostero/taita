---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar'
import RegistroForm from '../components/RegistroForm'
import { createSupabaseAdmin } from '../lib/supabase-admin'

const supabase = createSupabaseAdmin()
// Se identifica cada categoría por `id`, no por nombre — ver comentario en RegistroForm.tsx sobre
// por qué el matching por nombre rompía especialidades en silencio cuando se editaba una categoría.
const { data: cats } = await supabase
  .from('categorias')
  .select('id, nombre')
  .eq('activa', true)
  .order('nombre', { ascending: true })

const especialidades = cats ?? []
---

<Layout title="Registrarse — Taita Soluciones" description="Creá tu cuenta en Taita Soluciones">
  <Navbar client:load />

  <div class="min-h-screen bg-cream py-10 px-4">
    <!-- max-w-5xl (no max-w-lg como antes) — el form de técnico es un wizard con sidebar de pasos
         que necesita más ancho; el de cliente se auto-centra angosto adentro igual, ver
         RegistroForm.tsx. -->
    <div class="max-w-5xl mx-auto flex flex-col gap-6">

      <div class="text-center flex flex-col items-center gap-3">
        <a href="/">
          <div class="w-24 h-24">
            <img src="/images/taita-avatar.webp" alt="TAITA" class="w-full h-full object-contain mix-blend-multiply" />
          </div>
        </a>
        <div>
          <h1 class="font-serif font-bold text-primary text-2xl mb-1">Crear cuenta</h1>
          <p class="text-gray-400 text-sm">Unite a la comunidad</p>
        </div>
      </div>

      <RegistroForm especialidades={especialidades} client:load />

    </div>
  </div>
</Layout>
