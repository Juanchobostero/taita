---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar'
import { createSupabaseAdmin } from '../lib/supabase-admin'
import { toSlug } from '../lib/types'

const supabase = createSupabaseAdmin()

// Solo las categorías que el admin marcó como "destacada" (máximo 9, se controla desde
// /dashboard/admin/categorias) — el resto se ve en /categorias ("Ver más"). El .limit(9) queda
// como respaldo por si alguna vez hubiera más de 9 marcadas.
const { data: categoriasDB } = await supabase
  .from('categorias')
  .select('id, nombre, icono, imagen_url')
  .eq('activa', true)
  .eq('destacada', true)
  .order('nombre')
  .limit(9)

// Números reales para la tarjeta de confianza del hero — nada de cifras inventadas. Si el número
// es chico (plataforma recién arrancando), igual se muestra tal cual es; el copy está pensado
// para que lea bien sea cual sea el valor.
const [{ count: tecnicosActivos }, { count: serviciosRealizados }] = await Promise.all([
  supabase.from('tecnicos').select('*', { count: 'exact', head: true }).eq('activo', true),
  supabase.from('solicitudes').select('*', { count: 'exact', head: true }).in('estado', ['completada', 'finalizada']),
])

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Taita Soluciones',
  url: 'https://taitasoluciones.com.ar',
  logo: 'https://taitasoluciones.com.ar/images/taita-avatar.webp',
  description: 'Encontrá al técnico ideal para tu hogar en Argentina',
  areaServed: 'Argentina',
}
---

<Layout>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar client:load />

  <!-- HERO -->
  <section class="bg-cream py-12 px-8">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-8 md:gap-12">

      <!-- Mascota + tarjeta de confianza (solo desktop) -->
      <div class="shrink-0 relative">
        <img src="/images/taita-avatar.webp" alt="TAITA" class="w-40 h-40 md:w-48 md:h-48 object-contain mix-blend-multiply animate-fade-up hover:scale-105 transition-transform duration-300 ease-out cursor-pointer [clip-path:circle(50%)]" />

        <!-- Mismo estilo "metálico" con brillo al hover que la tarjeta de estimación del wizard
             (Fase 6a) — le da continuidad visual al rediseño. Números reales, no inventados. -->
        <div class="hidden md:block card-metallic group absolute -bottom-5 -right-10 w-48 p-4">
          <div class="card-metallic-shine" />
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold leading-none">{tecnicosActivos ?? 0}</p>
              <p class="text-[10px] text-white/70 uppercase tracking-wide mt-1">Técnicos activos</p>
            </div>
            <div class="w-px h-8 bg-white/20"></div>
            <div>
              <p class="text-2xl font-bold leading-none text-amber-400">{serviciosRealizados ?? 0}</p>
              <p class="text-[10px] text-white/70 uppercase tracking-wide mt-1">Servicios realizados</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contenido -->
      <div class="flex-1 flex flex-col items-center md:items-start text-center md:text-left">
        <span class="inline-block bg-primary-soft text-primary border border-primary-pale rounded-full px-3 py-1 text-xs font-medium mb-3">
          📍 Servicios a domicilio
        </span>

        <h1 class="font-serif font-bold text-primary text-[36px] sm:text-[56px] leading-none tracking-tight mb-1">
          TAITA
        </h1>

        <p class="font-serif italic text-primary-light text-[15px] sm:text-[17px] mb-4">
          Ayuda confiable, cuando la necesitás.
        </p>

        <p class="text-gray-500 text-sm leading-relaxed mb-5 max-w-md">
          Encontrá los mejores técnicos locales para refrigeración, electricidad,
          plomería y más. Rápido, seguro y garantizado.
        </p>

        <!-- Buscador + CTA — solo mobile, estilo app nativa (referencia que pasó Agustín) -->
        <div class="w-full md:hidden flex flex-col gap-3 mb-5">
          <button
            id="mobile-search-trigger"
            type="button"
            class="w-full flex items-center gap-2 bg-white border border-cream-dark rounded-full pl-4 pr-1.5 py-1.5 text-sm text-gray-400 shadow-sm"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <span class="flex-1 text-left truncate">¿Qué servicio necesitás hoy?</span>
            <span class="bg-primary text-white text-xs font-semibold px-4 py-2 rounded-full shrink-0">Buscar</span>
          </button>
          <a
            href="/solicitud"
            class="w-full text-center bg-primary hover:bg-primary-hover text-white font-bold py-3.5 rounded-full text-sm shadow-sm transition-colors"
          >
            Solicitar servicio ahora
          </a>
        </div>

        <div class="flex items-center gap-2 flex-wrap justify-center md:justify-start">
          <span class="text-xs text-gray-400 font-medium">Populares:</span>
          {(categoriasDB ?? []).slice(0, 4).map(c => (
            <a href={`/solicitud?categoria=${c.id}`}
               class="text-xs bg-white text-primary border border-primary-pale rounded-full px-3 py-1 font-medium hover:border-primary transition-colors">
              {c.nombre}
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <script>
    // El buscador mobile del hero reusa el mismo Command Palette (Ctrl+K) que ya tiene el navbar
    // de escritorio — no duplica lógica de búsqueda, solo dispara el mismo atajo.
    document.getElementById('mobile-search-trigger')?.addEventListener('click', () => {
      document.dispatchEvent(new KeyboardEvent('keydown', { ctrlKey: true, key: 'k', bubbles: true }))
    })
  </script>

  <!-- POR QUÉ USARNOS -->
  <section class="py-16 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <h2 class="font-serif font-bold text-primary text-2xl mb-1">¿Por qué usar Taita Soluciones?</h2>
        <p class="text-gray-400 text-sm">Construida para darte tranquilidad y resultados excelentes.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {[
          { icon: '🛡️', title: 'Seguridad garantizada', desc: 'Todos nuestros técnicos pasan por verificación de identidad y antecedentes.' },
          { icon: '⚡', title: 'Respuesta rápida',       desc: 'Encontrá ayuda para hoy mismo. Técnicos disponibles en tu zona en minutos.' },
          { icon: '⭐', title: 'Calidad evaluada',       desc: 'Leé reseñas reales de otros clientes de tu comunidad antes de contratar.' },
        ].map(({ icon, title, desc }) => (
          <div class="card-metallic group p-6 flex flex-col items-center text-center gap-3">
            <div class="card-metallic-shine" />
            <div class="w-11 h-11 bg-white/10 rounded-xl flex items-center justify-center text-[22px]">
              {icon}
            </div>
            <h3 class="text-sm font-semibold text-white">{title}</h3>
            <p class="text-xs text-white/65 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORÍAS -->
  <section class="py-16 px-4 bg-cream">
    <div class="max-w-6xl mx-auto">
      <div class="mb-8">
        <h2 class="font-serif font-bold text-primary text-2xl mb-1">Categorías populares</h2>
        <p class="text-gray-400 text-sm">Encontrá al experto adecuado para tu necesidad.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {(categoriasDB ?? []).map(c => (
          <a
            href={`/solicitud?categoria=${c.id}`}
            class="bg-white rounded-2xl border border-[#D8D4CC] hover:border-primary-hover p-6 flex flex-col items-center gap-3 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group cursor-pointer"
          >
            <div class="w-14 h-14 rounded-xl overflow-hidden flex items-center justify-center bg-gray-100 shrink-0">
              {c.imagen_url
                ? <img src={c.imagen_url} alt={c.nombre} class="w-full h-full object-cover" />
                : <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              }
            </div>
            <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors text-center">{c.nombre}</span>
          </a>
        ))}
      </div>
      <div class="flex justify-center mt-8">
        <a
          href="/categorias"
          class="bg-primary hover:bg-primary-hover text-white font-semibold px-8 py-3 rounded-full text-sm transition-colors shadow-sm"
        >
          Ver más categorías →
        </a>
      </div>
    </div>
  </section>

  <!-- BANNER CTA TÉCNICO -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="card-metallic group p-7 flex flex-col sm:flex-row items-center justify-between gap-5">
        <div class="card-metallic-shine" />
        <div>
          <h3 class="font-serif font-bold text-white text-xl mb-1.5">¿Sos taita y querés ofrecer tus servicios?</h3>
          <p class="text-sm text-white/70">Unite a nuestra comunidad y empezá a ganar.</p>
        </div>
        <a href="/registro?tipo=tecnico" class="bg-amber-500 hover:bg-amber-600 text-white rounded-full px-6 py-3 text-sm font-semibold shrink-0 transition-colors relative z-10">
          Quiero registrarme
        </a>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-16 px-4 bg-primary">
    <div class="max-w-2xl mx-auto text-center flex flex-col gap-6">
      <h2 class="font-serif font-bold text-white text-3xl">¿Listo para resolver tu problema?</h2>
      <p class="text-white/75 text-sm leading-relaxed">
        Unite a quienes ya confían en Taita Soluciones para mantener su hogar en perfecto estado.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/solicitud" class="bg-white text-primary font-bold px-7 py-3 rounded-full hover:bg-cream transition-colors text-sm">
          Solicitar servicio
        </a>
        <a href="/registro?tipo=tecnico" class="border-[1.5px] border-white/50 text-white font-medium px-7 py-3 rounded-full hover:bg-primary-hover transition-colors text-sm">
          Quiero ser técnico
        </a>
        <a href="/contacto" class="flex items-center gap-2 border-[1.5px] border-white/50 text-white font-medium px-7 py-3 rounded-full hover:bg-primary-hover transition-colors text-sm">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Contactanos
        </a>
        <a href="/reclamos" class="flex items-center gap-2 border-[1.5px] border-white/50 text-white font-medium px-7 py-3 rounded-full hover:bg-primary-hover transition-colors text-sm">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Reclamos
        </a>
        <a href="/terminos" class="flex items-center gap-2 border-[1.5px] border-white/50 text-white font-medium px-7 py-3 rounded-full hover:bg-primary-hover transition-colors text-sm">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
          Términos y Condiciones
        </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="bg-[#111111] text-gray-400 py-10 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2">
          <span class="font-serif font-bold text-white text-lg">taita</span>
          <span class="text-primary-light text-sm font-medium">soluciones</span>
        </div>
        <p class="text-xs text-gray-600">Servicios técnicos a domicilio — Argentina</p>
      </div>
      <div class="flex flex-col items-center gap-1">
        <p class="text-sm">© 2026 Taita Soluciones — Argentina</p>
        <p class="text-xs text-gray-600">Desarrollado por <a href="https://www.jotadev.com.ar" target="_blank" rel="noopener noreferrer" class="text-primary-light hover:text-white transition-colors font-medium">JOTADEV</a></p>
      </div>
      <div class="flex gap-6 text-sm">
        <a href="/solicitud" class="hover:text-primary-light transition-colors">Solicitar servicio</a>
        <a href="/contacto" class="hover:text-primary-light transition-colors">Contacto</a>
        <a href="/reclamos" class="hover:text-primary-light transition-colors">Reclamos</a>
      </div>
    </div>
  </footer>
</Layout>
