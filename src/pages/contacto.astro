---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar'
import { enviarEmail } from '../lib/email'

const tipo     = Astro.url.searchParams.get('tipo') === 'reclamo' ? 'reclamo' : 'contacto'
const esReclamo = tipo === 'reclamo'

let enviado = false
let errorMsg = ''

if (Astro.request.method === 'POST') {
  const form    = await Astro.request.formData()
  const email   = form.get('email')?.toString().trim()
  const telefono = form.get('telefono')?.toString().trim()
  const mensaje  = form.get('mensaje')?.toString().trim()
  const nombre   = form.get('nombre')?.toString().trim()

  if (!email || !mensaje) {
    errorMsg = 'Completá los campos requeridos.'
  } else {
    await enviarEmail({
      to:      'taitasoluciones@gmail.com',
      subject: `${esReclamo ? 'Reclamo' : 'Contacto'} de ${nombre || email}`,
      html: `
        <p><strong>Nombre:</strong> ${nombre || '—'}</p>
        <p><strong>Email:</strong> ${email}</p>
        <p><strong>Teléfono:</strong> ${telefono || '—'}</p>
        <p><strong>Mensaje:</strong></p>
        <p>${mensaje.replace(/\n/g, '<br />')}</p>
      `,
    })
    enviado = true
  }
}
---

<Layout
  title={esReclamo ? 'Reclamos — Taita Soluciones' : 'Contactanos — Taita Soluciones'}
  description="Estamos para ayudarte. Completá el formulario y nos ponemos en contacto."
>
  <Navbar client:load />

  <div class="bg-cream min-h-screen py-10 px-4">
    <div class="max-w-2xl mx-auto flex flex-col gap-8">

      <a href="/" class="text-primary hover:text-primary-hover font-medium flex items-center gap-1 w-fit text-sm">
        ← Volver al inicio
      </a>

      <!-- Hero -->
      <div class="flex items-center gap-6">
        <img
          src="/images/taita-avatar.webp"
          alt="TAITA"
          class="w-24 h-24 object-contain mix-blend-multiply shrink-0 hidden sm:block"
        />
        <div>
          <h1 class="font-serif font-bold text-primary text-4xl mb-1">
            {esReclamo ? 'Reclamos' : 'Contactanos'}
          </h1>
          <p class="font-serif italic text-primary-light text-base">Estamos para ayudarte.</p>
          <p class="text-gray-500 text-sm mt-2 leading-relaxed">
            {esReclamo
              ? 'Si tenés algún reclamo, completá el formulario y nuestro equipo se pondrá en contacto a la brevedad.'
              : 'Cualquier consulta, sugerencia o ayuda que necesites, escribinos.'}
          </p>
          <div class="flex items-center gap-2 mt-3 text-sm text-gray-600">
            <div class="w-8 h-8 rounded-full bg-primary-soft flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="font-medium text-primary">taitasoluciones@gmail.com</span>
          </div>
        </div>
      </div>

      <!-- Formulario -->
      <div class="bg-white rounded-2xl border border-cream-dark p-6 sm:p-8 flex flex-col gap-6">

        {enviado ? (
          <div class="flex flex-col items-center gap-4 py-8 text-center">
            <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center text-3xl">✅</div>
            <h2 class="font-serif font-bold text-primary text-2xl">¡Mensaje enviado!</h2>
            <p class="text-gray-500 text-sm">Nuestro equipo revisará tu mensaje y te responderá a la brevedad.</p>
            <a href="/" class="mt-2 bg-primary hover:bg-primary-hover text-white font-semibold px-6 py-2.5 rounded-full text-sm transition-colors">
              Volver al inicio
            </a>
          </div>
        ) : (
          <>
            <div>
              <h2 class="font-serif font-bold text-primary text-xl mb-0.5">
                {esReclamo ? 'Contanos tu reclamo' : 'Envianos tu consulta'}
              </h2>
              <p class="text-gray-400 text-sm">Completá los datos para que podamos ayudarte.</p>
            </div>

            {errorMsg && (
              <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3">
                {errorMsg}
              </div>
            )}

            <form method="POST" class="flex flex-col gap-4">

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-medium text-gray-700">Nombre</label>
                  <input
                    name="nombre"
                    type="text"
                    placeholder="Tu nombre"
                    class="border border-cream-dark rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
                  />
                </div>
                <div class="flex flex-col gap-1.5">
                  <label class="text-sm font-medium text-gray-700">Correo electrónico <span class="text-red-400">*</span></label>
                  <input
                    name="email"
                    type="email"
                    required
                    placeholder="ejemplo@correo.com"
                    class="border border-cream-dark rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
                  />
                </div>
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-gray-700">Número de teléfono</label>
                <input
                  name="telefono"
                  type="tel"
                  placeholder="Ej: 11 2345-6789"
                  class="border border-cream-dark rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary"
                />
              </div>

              <div class="flex flex-col gap-1.5">
                <label class="text-sm font-medium text-gray-700">
                  {esReclamo ? 'Describí tu reclamo' : 'Tu mensaje'} <span class="text-red-400">*</span>
                </label>
                <textarea
                  name="mensaje"
                  required
                  rows={5}
                  maxlength={1000}
                  placeholder={esReclamo ? 'Contanos en detalle cuál es tu reclamo...' : 'Escribí tu consulta o sugerencia...'}
                  class="border border-cream-dark rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-primary resize-none"
                ></textarea>
                <p class="text-xs text-gray-400 text-right">máx. 1000 caracteres</p>
              </div>

              <div class="bg-primary-soft border border-primary-pale rounded-xl px-4 py-3 flex items-start gap-2 text-sm text-primary">
                <svg class="w-4 h-4 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span>Nuestro equipo revisará tu {esReclamo ? 'reclamo' : 'consulta'} y te responderá a la brevedad.</span>
              </div>

              <div class="flex items-center justify-between gap-3 pt-2">
                <a href="/" class="flex items-center gap-1 text-sm text-gray-500 hover:text-primary transition-colors">
                  ← Volver al inicio
                </a>
                <button
                  type="submit"
                  class="bg-primary hover:bg-primary-hover text-white font-semibold px-8 py-2.5 rounded-full text-sm transition-colors"
                >
                  {esReclamo ? 'Enviar reclamo' : 'Enviar mensaje'}
                </button>
              </div>

            </form>
          </>
        )}
      </div>

    </div>
  </div>

  <!-- Banner técnico -->
  <section class="py-10 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="bg-primary-soft rounded-2xl border border-primary-pale p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-serif font-bold text-primary text-lg mb-1">¿Sos taita y querés ofrecer tus servicios?</h3>
          <p class="text-sm text-gray-500">Unite a nuestra comunidad y empezá a ganar.</p>
        </div>
        <a href="/registro?tipo=tecnico" class="bg-primary hover:bg-primary-hover text-white rounded-full px-6 py-2.5 text-sm font-semibold shrink-0 transition-colors">
          Quiero registrarme
        </a>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-12 px-4 bg-primary">
    <div class="max-w-2xl mx-auto text-center flex flex-col gap-5">
      <h2 class="font-serif font-bold text-white text-2xl">¿Listo para resolver tu problema?</h2>
      <p class="text-white/75 text-sm">Unite a quienes ya confían en Taita Soluciones.</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/solicitud" class="bg-white text-primary font-bold px-6 py-2.5 rounded-full hover:bg-cream transition-colors text-sm">Solicitar servicio</a>
        <a href="/registro?tipo=tecnico" class="border-[1.5px] border-white/50 text-white font-medium px-6 py-2.5 rounded-full hover:bg-primary-hover transition-colors text-sm">Quiero ser técnico</a>
        <a href="/contacto" class="flex items-center gap-1.5 border-[1.5px] border-white/50 text-white font-medium px-6 py-2.5 rounded-full hover:bg-primary-hover transition-colors text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Contactanos
        </a>
        <a href="/reclamos" class="flex items-center gap-1.5 border-[1.5px] border-white/50 text-white font-medium px-6 py-2.5 rounded-full hover:bg-primary-hover transition-colors text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Reclamos
        </a>
      </div>
    </div>
  </section>

</Layout>
