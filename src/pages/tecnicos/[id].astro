---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar'
import { createSupabaseAdmin } from '../../lib/supabase-admin'
import type { TecnicoConUsuario, ResenaConAutor } from '../../lib/types'

const { id } = Astro.params
if (!id) return Astro.redirect('/tecnicos')

const supabase = createSupabaseAdmin()

const { data: raw } = await supabase
  .from('tecnicos')
  .select(`
    id, descripcion, zona_cobertura, tarifa_hora, nick, mostrar_nombre,
    calificacion_promedio, total_servicios, activo,
    usuarios!inner ( nombre_completo, telefono, foto_url ),
    especialidades_tecnico (
      subcategorias,
      categorias ( id, nombre, icono )
    )
  `)
  .eq('id', id)
  .single()

if (!raw) return Astro.redirect('/tecnicos')

const tecnico = raw as TecnicoConUsuario

const { data: rawResenas } = await supabase
  .from('resenas')
  .select(`
    id, calificacion, comentario, creado_en,
    usuarios!cliente_id ( nombre_completo )
  `)
  .eq('tecnico_id', id)
  .order('creado_en', { ascending: false })
  .limit(5)

const resenas = (rawResenas ?? []) as ResenaConAutor[]

const nick           = (tecnico as any).nick as string | null
const mostrarNombre  = (tecnico as any).mostrar_nombre as boolean ?? true
const nombreDisplay  = nick || tecnico.usuarios.nombre_completo
const iniciales      = nombreDisplay.split(' ').slice(0, 2).map((p: string) => p[0]).join('')
const especialidades = tecnico.especialidades_tecnico.map(e => e.categorias?.nombre).filter(Boolean)

// Datos estructurados para que Google pueda mostrar la calificación en el resultado de búsqueda.
// Solo se incluye aggregateRating si ya hay servicios calificados — Google penaliza/ignora un
// rating sin reseñas reales detrás.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: especialidades[0] ?? 'Servicio técnico a domicilio',
  provider: {
    '@type': 'Person',
    name: nombreDisplay,
    ...(tecnico.usuarios.foto_url ? { image: tecnico.usuarios.foto_url } : {}),
  },
  areaServed: tecnico.zona_cobertura ?? 'Argentina',
  ...(tecnico.total_servicios > 0 ? {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: Number(tecnico.calificacion_promedio).toFixed(1),
      reviewCount: tecnico.total_servicios,
    },
  } : {}),
}
---

<Layout
  title={`${tecnico.usuarios.nombre_completo} — Taita Soluciones`}
  description={tecnico.descripcion ?? ''}
  image={tecnico.usuarios.foto_url ?? undefined}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar client:load />

  <div class="bg-gray-50 min-h-screen py-10 px-4">
    <div class="max-w-4xl mx-auto flex flex-col gap-6">

      <a href="/tecnicos" class="text-primary hover:text-primary-hover font-medium flex items-center gap-1 w-fit text-sm">
        ← Volver a técnicos
      </a>

      <!-- Perfil -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-6">
        <div class="flex flex-col items-center sm:items-start gap-3">
          <div class="w-24 h-24 rounded-2xl bg-primary-soft flex items-center justify-center text-primary font-bold text-2xl overflow-hidden">
            {tecnico.usuarios.foto_url
              ? <img src={tecnico.usuarios.foto_url} alt={tecnico.usuarios.nombre_completo} class="w-full h-full object-cover" />
              : iniciales
            }
          </div>
          {tecnico.activo
            ? <span class="text-sm bg-green-100 text-green-600 px-3 py-1 rounded-full font-medium">Disponible</span>
            : <span class="text-sm bg-gray-100 text-gray-400 px-3 py-1 rounded-full font-medium">No disponible</span>
          }
        </div>

        <div class="flex-1 flex flex-col gap-3">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">{nombreDisplay}</h1>
            {nick && mostrarNombre && (
              <p class="text-sm text-gray-400">{tecnico.usuarios.nombre_completo}</p>
            )}
            <p class="text-primary font-semibold">{especialidades[0] ?? 'Servicio general'}</p>
          </div>
          <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-500">
            <span>⭐ <strong class="text-gray-800">{Number(tecnico.calificacion_promedio).toFixed(1)}</strong> ({tecnico.total_servicios} servicios)</span>
            {tecnico.zona_cobertura && <span>📍 {tecnico.zona_cobertura}</span>}
          </div>
          {tecnico.descripcion && <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{tecnico.descripcion}</p>}
          {tecnico.especialidades_tecnico.length > 0 && (
            <div class="flex flex-col gap-2 mt-1">
              {tecnico.especialidades_tecnico.map(esp => {
                const subs = (esp as any).subcategorias as string[] | null
                return (
                  <div class="flex flex-col gap-1">
                    <span class="bg-primary-soft text-primary text-xs font-medium px-3 py-1 rounded-full w-fit">
                      {esp.categorias?.nombre}
                    </span>
                    {subs?.length && (
                      <div class="flex flex-wrap gap-1 pl-2">
                        {subs.map(s => (
                          <span class="text-xs text-gray-500 bg-gray-100 px-2 py-0.5 rounded-full">{s}</span>
                        ))}
                      </div>
                    )}
                  </div>
                )
              })}
            </div>
          )}
        </div>
      </div>

      <!-- Info precio -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100">
        <p class="text-gray-500 text-sm">El precio varía según el tipo de servicio solicitado.</p>
      </div>

      <!-- Reseñas -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gray-100 flex flex-col gap-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl font-bold text-gray-900">Reseñas</h2>
          <span class="text-sm text-gray-400">{tecnico.total_servicios} servicios realizados</span>
        </div>

        {resenas.length === 0
          ? <p class="text-gray-400 text-sm py-4 text-center">Todavía no hay reseñas para este técnico.</p>
          : (
            <div class="flex flex-col divide-y divide-gray-50">
              {resenas.map(r => (
                <div class="py-4 first:pt-0 last:pb-0 flex flex-col gap-1.5">
                  <div class="flex items-center justify-between">
                    <p class="font-semibold text-gray-900 text-sm">{r.usuarios?.nombre_completo ?? 'Cliente'}</p>
                    <p class="text-yellow-400 text-sm">{'⭐'.repeat(r.calificacion)}</p>
                  </div>
                  {r.comentario && <p class="text-gray-500 text-sm leading-relaxed">{r.comentario}</p>}
                  <p class="text-xs text-gray-300">
                    {new Date(r.creado_en).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires' })}
                  </p>
                </div>
              ))}
            </div>
          )
        }
      </div>

    </div>
  </div>

  <footer class="bg-gray-900 text-gray-400 py-10 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="text-white font-bold text-xl">Taita <span class="text-primary-light">Soluciones</span></span>
      <p class="text-sm">© 2026 Taita Soluciones — Argentina</p>
      <div class="flex gap-6 text-sm">
        <a href="#" class="hover:text-primary-light transition-colors">Términos</a>
        <a href="#" class="hover:text-primary-light transition-colors">Privacidad</a>
        <a href="#" class="hover:text-primary-light transition-colors">Contacto</a>
      </div>
    </div>
  </footer>
</Layout>
