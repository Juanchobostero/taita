---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar'
import FiltroTecnicos from '../../components/FiltroTecnicos'
import { createSupabaseAdmin } from '../../lib/supabase-admin'
import { tecnicoToDisplay } from '../../lib/types'
import type { TecnicoConUsuario } from '../../lib/types'

const supabase = createSupabaseAdmin()

const [{ data: rawTecnicos, error }, { data: rawCategorias }] = await Promise.all([
  supabase
    .from('tecnicos')
    .select(`
      id, descripcion, zona_cobertura, tarifa_hora, nick, mostrar_nombre,
      calificacion_promedio, total_servicios, activo,
      usuarios!inner ( nombre_completo, telefono, foto_url ),
      especialidades_tecnico (
        categorias ( id, nombre, icono )
      )
    `)
    .eq('activo', true)
    .order('calificacion_promedio', { ascending: false }),
  supabase
    .from('categorias')
    .select('id, nombre, icono, imagen_url')
    .eq('activa', true)
    .order('nombre'),
])

const tecnicos         = (rawTecnicos as TecnicoConUsuario[] ?? []).map(tecnicoToDisplay)
const categoriasFiltro = rawCategorias ?? []
---

<Layout title="Técnicos disponibles — Taita Soluciones" description="Encontrá al técnico ideal para tu hogar">
  <Navbar client:load />

  <div class="bg-cream min-h-screen">
    <div class="bg-primary">
      <div class="max-w-6xl mx-auto px-4 pt-10 pb-16">
        <h1 class="font-serif font-bold text-white text-3xl sm:text-4xl">Técnicos disponibles</h1>
        <p class="text-white/70 mt-2">
          {error
            ? 'Error cargando técnicos.'
            : `${tecnicos.length} profesional${tecnicos.length !== 1 ? 'es' : ''} verificado${tecnicos.length !== 1 ? 's' : ''} disponible${tecnicos.length !== 1 ? 's' : ''}.`
          }
        </p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 -mt-8 pb-16">
      <FiltroTecnicos client:load tecnicos={tecnicos} categoriasFiltro={categoriasFiltro} />
    </div>
  </div>

  <footer class="bg-gray-900 text-gray-400 py-10 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
      <span class="text-white font-bold text-xl">Taita <span class="text-primary-light">Soluciones</span></span>
      <p class="text-sm">© 2026 Taita Soluciones — Argentina</p>
      <div class="flex gap-6 text-sm">
        <a href="#" class="hover:text-primary-light transition-colors">Términos</a>
        <a href="#" class="hover:text-primary-light transition-colors">Privacidad</a>
        <a href="#" class="hover:text-primary-light transition-colors">Contacto</a>
      </div>
    </div>
  </footer>
</Layout>
