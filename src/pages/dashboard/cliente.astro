---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar'
import AvatarUpload from '../../components/AvatarUpload'
import MisSolicitudes from '../../components/MisSolicitudes'
import { createSupabaseAdmin } from '../../lib/supabase-admin'
import { notificarEmailVerificado } from '../../lib/notificaciones'

const PAGE_SIZE = 5

const supabase = createSupabaseAdmin()
const userId = Astro.locals.user!.id

const [
  { data: usuario },
  { data: rawSolicitudes, count: totalSolicitudes },
  { count: pendientesCount },
  { count: enCursoCount },
  { count: completadasCount },
  { data: rawCategorias },
] = await Promise.all([
  supabase
    .from('usuarios')
    .select('nombre_completo, email, telefono, foto_url, email_verificado, email_verificado_notificado')
    .eq('id', userId)
    .single(),
  supabase
    .from('solicitudes')
    .select(`
      id, numero, titulo, descripcion, estado, direccion, tecnico_id,
      precio_base, tasa_aplicada, total_estimado, fecha_solicitada, hora_solicitada, creado_en,
      tecnicos ( usuarios ( nombre_completo ) ),
      categorias ( nombre, icono ),
      resenas ( id )
    `, { count: 'exact' })
    .eq('cliente_id', userId)
    .order('actualizado_en', { ascending: false })
    .range(0, PAGE_SIZE - 1),
  // Incluye "en_cotizacion" — para el cliente, esperar una cotización es tan "pendiente" como
  // esperar que se le asigne un técnico (Fase 7b).
  supabase.from('solicitudes').select('*', { count: 'exact', head: true })
    .eq('cliente_id', userId).in('estado', ['pendiente', 'asignada', 'en_cotizacion']),
  supabase.from('solicitudes').select('*', { count: 'exact', head: true })
    .eq('cliente_id', userId).in('estado', ['aceptada', 'en_curso']),
  // Incluye "finalizada" además de "completada" — para el cliente es el mismo trabajo terminado,
  // solo que el técnico ya hizo el cierre administrativo interno (Fase 5); si no, este contador
  // "perdía" solicitudes apenas se cerraban.
  supabase.from('solicitudes').select('*', { count: 'exact', head: true })
    .eq('cliente_id', userId).in('estado', ['completada', 'finalizada']),
  // Para el filtro por categoría del listado (FiltrosSolicitudes) — solo las activas, mismo
  // criterio que el resto de los selectores de categoría del sitio.
  supabase.from('categorias').select('id, nombre, icono').eq('activa', true).order('nombre'),
])

const solicitudes = rawSolicitudes ?? []
const categoriasFiltro = rawCategorias ?? []

// Fase 8.1 — se detecta acá (en vez de con un listener client-side de Supabase Auth, que no
// distingue de forma confiable "recién confirmó" de "es un login normal") que el cliente ya
// confirmó su email pero todavía no se le avisó — pasa una sola vez, la próxima carga del panel
// después de haber clickeado el link de confirmación. Reusa la consulta que ya se hacía para el
// perfil, no agrega una llamada nueva.
if (usuario?.email_verificado && !usuario?.email_verificado_notificado) {
  try {
    await notificarEmailVerificado(supabase, userId, usuario.nombre_completo, usuario.email)
    await supabase.from('usuarios').update({ email_verificado_notificado: true }).eq('id', userId)
  } catch (err) {
    console.error('[dashboard/cliente] error notificando email verificado:', err)
  }
}

const stats = {
  pendientes:  pendientesCount ?? 0,
  en_curso:    enCursoCount ?? 0,
  completadas: completadasCount ?? 0,
}

const nombre = usuario?.nombre_completo?.split(' ')[0] ?? 'Cliente'
---

<Layout title="Mi panel — Taita Soluciones">
  <Navbar client:load />

  <div class="bg-cream min-h-screen py-8 px-4">
    <div class="max-w-5xl mx-auto flex flex-col gap-6">

      <!-- Aviso de email sin confirmar (Fase 8.1) — no bloquea navegar, sí pedir un servicio nuevo
           (ese bloqueo está en el propio wizard, /solicitud). -->
      {!usuario?.email_verificado && (
        <div class="bg-amber-50 border border-amber-200 text-amber-800 text-sm rounded-2xl px-5 py-3.5">
          📩 Todavía no confirmaste tu email — revisá tu casilla y confirmalo para poder pedir servicios.
        </div>
      )}

      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="font-serif font-bold text-[#1B4D2E] text-2xl">Bienvenido, {nombre} 👋</h1>
          <p class="text-gray-500 text-sm mt-0.5">Panel del cliente</p>
        </div>
        <a
          href="/solicitud"
          class="bg-[#1B4D2E] hover:bg-primary-hover text-white font-semibold px-5 py-2.5 rounded-full transition-colors text-sm w-fit"
        >
          + Nueva solicitud
        </a>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card-metallic group p-5 flex flex-col gap-1">
          <div class="card-metallic-shine" />
          <p class="text-sm text-white/70">Solicitudes pendientes</p>
          <p class="text-3xl font-bold text-amber-400">{stats.pendientes}</p>
        </div>
        <div class="card-metallic group p-5 flex flex-col gap-1">
          <div class="card-metallic-shine" />
          <p class="text-sm text-white/70">En curso</p>
          <p class="text-3xl font-bold text-sky-300">{stats.en_curso}</p>
        </div>
        <div class="card-metallic group p-5 flex flex-col gap-1">
          <div class="card-metallic-shine" />
          <p class="text-sm text-white/70">Completadas</p>
          <p class="text-3xl font-bold text-white">{stats.completadas}</p>
        </div>
      </div>

      <!-- Solicitudes -->
      <div class="bg-white rounded-2xl border border-cream-dark overflow-hidden">
        <div class="px-6 py-4 border-b border-cream">
          <h2 class="font-serif font-bold text-[#1B4D2E] text-lg">Mis solicitudes</h2>
        </div>

        <MisSolicitudes client:load userId={userId} initialData={solicitudes as any} initialTotal={totalSolicitudes ?? 0} categorias={categoriasFiltro} />
      </div>

      <!-- Perfil -->
      <div class="bg-white rounded-2xl border border-cream-dark p-6 flex flex-col gap-4">
        <h2 class="font-serif font-bold text-[#1B4D2E] text-lg">Mi perfil</h2>
        <div class="flex justify-center">
          <AvatarUpload
            client:load
            userId={userId}
            currentUrl={usuario?.foto_url ?? null}
            nombre={usuario?.nombre_completo ?? 'U'}
          />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="flex flex-col gap-1">
            <span class="text-gray-400">Nombre</span>
            <span class="font-medium text-gray-800">{usuario?.nombre_completo ?? '—'}</span>
          </div>
          <div class="flex flex-col gap-1">
            <span class="text-gray-400">Email</span>
            <span class="font-medium text-gray-800">{usuario?.email ?? Astro.locals.user?.email ?? '—'}</span>
          </div>
          {usuario?.telefono && (
            <div class="flex flex-col gap-1">
              <span class="text-gray-400">Teléfono</span>
              <span class="font-medium text-gray-800">{usuario.telefono}</span>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</Layout>
