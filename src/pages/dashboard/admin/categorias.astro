---
import Layout from '../../../layouts/Layout.astro'
import Navbar from '../../../components/Navbar'
import GestionCategorias from '../../../components/GestionCategorias'
import { createSupabaseAdmin } from '../../../lib/supabase-admin'

const supabase = createSupabaseAdmin()
const userId = Astro.locals.user!.id

const { data: self } = await supabase
  .from('usuarios')
  .select('tipo')
  .eq('id', userId)
  .single()

if (self?.tipo !== 'admin') return Astro.redirect('/dashboard/cliente')

const { data: rawCategorias } = await supabase
  .from('categorias')
  .select('id, nombre, icono, imagen_url, porcentaje_tasa, precio_base, activa')
  .order('nombre')

const categorias = rawCategorias ?? []
---

<Layout title="Categorías — Admin Taita">
  <Navbar client:load />

  <div class="bg-cream min-h-screen py-8 px-4">
    <div class="max-w-3xl mx-auto flex flex-col gap-6">

      <div>
        <a href="/dashboard/admin" class="text-xs text-gray-400 hover:text-primary transition-colors">← Panel admin</a>
        <h1 class="font-serif font-bold text-[#1B4D2E] text-2xl mt-1">Categorías de servicio</h1>
      </div>

      <GestionCategorias client:load inicial={categorias} />

    </div>
  </div>
</Layout>
