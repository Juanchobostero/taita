---
import Layout from '../../../../layouts/Layout.astro'
import Navbar from '../../../../components/Navbar'
import GaleriaFotos from '../../../../components/GaleriaFotos'
import { createSupabaseAdmin } from '../../../../lib/supabase-admin'
import { notificarCambioEstado } from '../../../../lib/notificaciones'
import { chequearDisponibilidad } from '../../../../lib/disponibilidad'

const { id } = Astro.params
if (!id) return Astro.redirect('/dashboard/admin')

const supabase   = createSupabaseAdmin()
const userId     = Astro.locals.user!.id

const { data: self } = await supabase.from('usuarios').select('tipo').eq('id', userId).single()
if (self?.tipo !== 'admin') return Astro.redirect('/dashboard/cliente')

if (Astro.request.method === 'POST') {
  const form   = await Astro.request.formData()
  const accion = form.get('accion')?.toString()

  if (accion === 'cambiar-estado') {
    const estado  = form.get('estado')?.toString()
    const validos = ['pendiente', 'aceptada', 'en_curso', 'completada', 'cancelada']
    const requiereTecnico = ['aceptada', 'en_curso', 'completada']
    if (estado && validos.includes(estado)) {
      // No permitir avanzar si no hay técnico asignado
      if (requiereTecnico.includes(estado)) {
        const { data: check } = await supabase
          .from('solicitudes').select('tecnico_id').eq('id', id).single()
        if (!check?.tecnico_id) return Astro.redirect(`/dashboard/admin/solicitud/${id}`)
      }
      // "Pendiente" siempre significa "sin técnico" — si se vuelve a este estado, desasignar
      // también, para no dejar la agenda del técnico con una reserva fantasma.
      if (estado === 'pendiente') {
        await supabase.from('solicitudes').update({ tecnico_id: null }).eq('id', id)
      }
      try {
        await notificarCambioEstado(supabase, id, estado, userId)
      } catch (err) {
        console.error('[cambiar-estado]', err)
      }
    }
  } else if (accion === 'asignar-tecnico') {
    const tecnicoId  = form.get('tecnicoId')?.toString()
    const forzar     = form.get('forzar')?.toString() === '1'
    const nuevaFecha = form.get('nuevaFecha')?.toString()
    const nuevaHora  = form.get('nuevaHora')?.toString()

    if (tecnicoId) {
      if (!forzar) {
        const { data: actual } = await supabase
          .from('solicitudes').select('fecha_solicitada, hora_solicitada, horas_estimadas').eq('id', id).single()
        if (actual?.fecha_solicitada && actual?.hora_solicitada) {
          const disponibilidad = await chequearDisponibilidad(supabase, {
            tecnicoId,
            fecha:              actual.fecha_solicitada,
            hora:               actual.hora_solicitada,
            horasEstimadas:     actual.horas_estimadas ?? 1,
            excluirSolicitudId: id,
          })
          if (!disponibilidad.disponible) {
            const params = new URLSearchParams({ conflicto: '1', tecnicoId })
            if (disponibilidad.sugerido) {
              params.set('sugFecha', disponibilidad.sugerido.fecha)
              params.set('sugHora', disponibilidad.sugerido.hora)
            }
            return Astro.redirect(`/dashboard/admin/solicitud/${id}?${params.toString()}`)
          }
        }
      }

      // Si se forzó la asignación reagendando al horario sugerido, mover la solicitud a ese
      // horario antes de asignar — así admin y cliente ven la fecha/hora real y consistente.
      if (forzar && nuevaFecha && nuevaHora) {
        const { error: reagendarError } = await supabase.from('solicitudes')
          .update({ fecha_solicitada: nuevaFecha, hora_solicitada: nuevaHora })
          .eq('id', id)
        if (reagendarError) console.error('[asignar-tecnico] error reagendando:', reagendarError.message)
      }

      const { error } = await supabase.from('solicitudes')
        .update({ tecnico_id: tecnicoId })
        .eq('id', id)
      if (error) {
        console.error('[asignar-tecnico]', error.message)
      } else {
        try {
          await notificarCambioEstado(supabase, id, 'aceptada', userId)
        } catch (err) {
          console.error('[asignar-tecnico] error notificando:', err)
        }
        if (forzar && nuevaFecha && nuevaHora) {
          const params = new URLSearchParams({ reagendado: '1', fecha: nuevaFecha, hora: nuevaHora })
          return Astro.redirect(`/dashboard/admin/solicitud/${id}?${params.toString()}`)
        }
      }
    }
  }
  return Astro.redirect(`/dashboard/admin/solicitud/${id}`)
}

const conflictoTecnicoId = Astro.url.searchParams.get('conflicto') === '1' ? Astro.url.searchParams.get('tecnicoId') : null
const conflictoSugFecha  = Astro.url.searchParams.get('sugFecha')
const conflictoSugHora   = Astro.url.searchParams.get('sugHora')

const reagendadoFecha = Astro.url.searchParams.get('reagendado') === '1' ? Astro.url.searchParams.get('fecha') : null
const reagendadoHora  = Astro.url.searchParams.get('reagendado') === '1' ? Astro.url.searchParams.get('hora')  : null

const { data: sol } = await supabase
  .from('solicitudes')
  .select(`
    id, titulo, descripcion, estado, creado_en,
    tecnico_id, categoria_id,
    horas_estimadas, precio_base, tasa_aplicada, total_estimado,
    gastos_extra, descripcion_gastos, imagenes_trabajo,
    fecha_solicitada, hora_solicitada, direccion,
    usuarios!cliente_id ( nombre_completo, telefono, email ),
    tecnicos ( tarifa_hora, usuarios ( nombre_completo, telefono ) ),
    categorias ( nombre, icono, porcentaje_tasa )
  `)
  .eq('id', id)
  .single()

if (!sol) return Astro.redirect('/dashboard/admin')

// Técnicos activos con esa categoría como especialidad
const { data: rawTecnicosActivos } = await supabase
  .from('tecnicos')
  .select('id, nick, mostrar_nombre, usuarios!inner ( nombre_completo ), especialidades_tecnico!inner ( categoria_id )')
  .eq('activo', true)
  .eq('especialidades_tecnico.categoria_id', sol.categoria_id)

const tecnicosActivos = (rawTecnicosActivos ?? []).map((t: any) => ({
  id: t.id,
  nombre: t.nick || t.usuarios.nombre_completo,
})) as { id: string; nombre: string }[]

const cliente  = sol.usuarios as any
const tecnico  = sol.tecnicos as any
const categoria = sol.categorias as any

const precioBase         = sol.precio_base         as number | null
const tasa               = sol.tasa_aplicada        as number | null
const total              = sol.total_estimado       as number | null
const gananciaPlataforma = (precioBase != null && total != null) ? total - precioBase : null
const cobrarAlTecnico    = precioBase
const gastosExtra        = sol.gastos_extra         as number | null
const descGastos         = sol.descripcion_gastos   as string | null
const imagenesTrabajo    = (sol.imagenes_trabajo    as string[] | null) ?? []

const estadoLabel: Record<string, string> = {
  pendiente:  'Pendiente',
  aceptada:   'Aceptada',
  en_curso:   'En curso',
  completada: 'Completada',
  cancelada:  'Cancelada',
}
const estadoColor: Record<string, string> = {
  pendiente:  'bg-amber-100 text-amber-800',
  aceptada:   'bg-blue-100 text-blue-800',
  en_curso:   'bg-blue-100 text-blue-800',
  completada: 'bg-primary-soft text-[#1B4D2E]',
  cancelada:  'bg-gray-100 text-gray-500',
}

const fmt = (n: number) => `$${n.toLocaleString('es-AR', { minimumFractionDigits: 0 })}`
---

<Layout title={`Solicitud — ${sol.titulo}`}>
  <Navbar client:load />

  <div class="bg-cream min-h-screen py-8 px-4">
    <div class="max-w-4xl mx-auto flex flex-col gap-6">

      <!-- Encabezado -->
      <div>
        <a href="/dashboard/admin" class="text-primary hover:text-primary-hover text-sm font-medium flex items-center gap-1 w-fit mb-4">
          ← Volver al panel
        </a>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex flex-col gap-1">
            <h1 class="font-serif font-bold text-[#1B4D2E] text-2xl">{sol.titulo}</h1>
            <p class="text-gray-400 text-sm">
              {categoria?.icono} {categoria?.nombre} ·
              Creada el {new Date(sol.creado_en).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' })}
            </p>
          </div>
          <span class={`text-sm font-semibold px-4 py-1.5 rounded-full w-fit ${estadoColor[sol.estado]}`}>
            {estadoLabel[sol.estado]}
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Col izquierda (2/3) -->
        <div class="lg:col-span-2 flex flex-col gap-6">

          <!-- Partes involucradas -->
          <div class="bg-white rounded-2xl border border-cream-dark p-6 flex flex-col gap-5">
            <h2 class="font-serif font-bold text-[#1B4D2E] text-base">Partes involucradas</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

              <!-- Cliente -->
              <div class="flex flex-col gap-3">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Cliente</p>
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-bold text-sm shrink-0">
                    {cliente?.nombre_completo?.split(' ').slice(0,2).map((p: string) => p[0]).join('') ?? '?'}
                  </div>
                  <div class="flex flex-col gap-0.5">
                    <p class="font-semibold text-gray-900 text-sm">{cliente?.nombre_completo ?? '—'}</p>
                    {cliente?.telefono && <p class="text-xs text-gray-400">📞 {cliente.telefono}</p>}
                    {cliente?.email    && <p class="text-xs text-gray-400">✉️ {cliente.email}</p>}
                  </div>
                </div>
              </div>

              <!-- Técnico -->
              <div class="flex flex-col gap-3">
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Técnico asignado</p>
                {reagendadoFecha && reagendadoHora && (
                  <div class="bg-primary-soft border border-primary-pale text-[#1B4D2E] text-xs rounded-xl px-3 py-2.5">
                    ✅ La solicitud se reagendó al {new Date(`${reagendadoFecha}T00:00:00`).toLocaleDateString('es-AR')} a
                    las {reagendadoHora} y se asignó el técnico. El cliente fue notificado con el nuevo horario.
                  </div>
                )}
                {tecnico ? (
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-primary-soft flex items-center justify-center text-primary font-bold text-sm shrink-0">
                      {tecnico.usuarios?.nombre_completo?.split(' ').slice(0,2).map((p: string) => p[0]).join('') ?? '?'}
                    </div>
                    <div class="flex flex-col gap-0.5">
                      <p class="font-semibold text-gray-900 text-sm">{tecnico.usuarios?.nombre_completo ?? '—'}</p>
                      {tecnico.usuarios?.telefono && <p class="text-xs text-gray-400">📞 {tecnico.usuarios.telefono}</p>}
                    </div>
                  </div>
                ) : (
                  <form method="POST" class="flex flex-col gap-2">
                    <input type="hidden" name="accion" value="asignar-tecnico" />
                    {conflictoTecnicoId && (
                      <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs rounded-xl px-3 py-2.5 flex flex-col gap-2">
                        <p>
                          {tecnicosActivos.find(t => t.id === conflictoTecnicoId)?.nombre ?? 'Este técnico'} ya
                          tiene otro trabajo agendado en el horario de esta solicitud.
                          {conflictoSugFecha && conflictoSugHora
                            ? ` Horario libre más cercano: ${new Date(`${conflictoSugFecha}T00:00:00`).toLocaleDateString('es-AR')} a las ${conflictoSugHora}.`
                            : ' No encontramos un horario libre cercano en los próximos 14 días.'}
                        </p>
                        <form method="POST">
                          <input type="hidden" name="accion" value="asignar-tecnico" />
                          <input type="hidden" name="tecnicoId" value={conflictoTecnicoId} />
                          <input type="hidden" name="forzar" value="1" />
                          {conflictoSugFecha && conflictoSugHora ? (
                            <>
                              <input type="hidden" name="nuevaFecha" value={conflictoSugFecha} />
                              <input type="hidden" name="nuevaHora" value={conflictoSugHora} />
                              <button type="submit" class="text-xs font-semibold text-amber-900 underline">
                                Reagendar a ese horario y asignar
                              </button>
                            </>
                          ) : (
                            <button type="submit" class="text-xs font-semibold text-amber-900 underline">
                              Asignar igual en el horario original (el admin decide)
                            </button>
                          )}
                        </form>
                      </div>
                    )}
                    {tecnicosActivos.length === 0 ? (
                      <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-xl px-3 py-2">
                        No hay técnicos activos para la categoría de esta solicitud.
                      </p>
                    ) : (
                      <>
                        <select
                          name="tecnicoId"
                          required
                          class="w-full border border-cream-dark rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-primary bg-white"
                        >
                          <option value="">Elegir técnico…</option>
                          {tecnicosActivos.map(t => (
                            <option value={t.id}>{t.nombre}</option>
                          ))}
                        </select>
                        <button
                          type="submit"
                          class="bg-primary hover:bg-primary-hover text-white text-sm font-semibold py-2 rounded-xl transition-colors"
                        >
                          Asignar técnico
                        </button>
                      </>
                    )}
                  </form>
                )}
              </div>

            </div>
          </div>

          <!-- Detalles del trabajo -->
          <div class="bg-white rounded-2xl border border-cream-dark p-6 flex flex-col gap-4">
            <h2 class="font-serif font-bold text-[#1B4D2E] text-base">Detalles del trabajo</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
              {sol.descripcion && (
                <div class="sm:col-span-2 flex flex-col gap-1">
                  <span class="text-gray-400 text-xs uppercase tracking-wide">Descripción</span>
                  <p class="text-gray-700 leading-relaxed">{sol.descripcion}</p>
                </div>
              )}
              <div class="flex flex-col gap-1">
                <span class="text-gray-400 text-xs uppercase tracking-wide">Dirección</span>
                <p class="text-gray-800 font-medium">📍 {sol.direccion ?? '—'}</p>
              </div>
              <div class="flex flex-col gap-1">
                <span class="text-gray-400 text-xs uppercase tracking-wide">Fecha y hora preferida</span>
                <p class="text-gray-800 font-medium">
                  📅 {sol.fecha_solicitada
                    ? new Date(sol.fecha_solicitada).toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' })
                    : '—'}
                  {sol.hora_solicitada && ` · ${(sol.hora_solicitada as string).slice(0, 5)} hs`}
                </p>
              </div>
              {sol.horas_estimadas && (
                <div class="flex flex-col gap-1">
                  <span class="text-gray-400 text-xs uppercase tracking-wide">Horas estimadas</span>
                  <p class="text-gray-800 font-medium">⏱ {sol.horas_estimadas} h</p>
                </div>
              )}
            </div>
          </div>

          <!-- Cierre del trabajo (fotos + gastos) -->
          {sol.estado === 'completada' && (imagenesTrabajo.length > 0 || gastosExtra != null) && (
            <div class="bg-white rounded-2xl border border-cream-dark p-6 flex flex-col gap-4">
              <h2 class="font-serif font-bold text-[#1B4D2E] text-base">Cierre del trabajo</h2>

              {imagenesTrabajo.length > 0 && (
                <div class="flex flex-col gap-2">
                  <span class="text-xs text-gray-400 uppercase tracking-wide">Fotos del trabajo</span>
                  <GaleriaFotos urls={imagenesTrabajo} client:load />
                </div>
              )}

              {gastosExtra != null && gastosExtra > 0 && (
                <div class="flex flex-col gap-2">
                  <span class="text-xs text-gray-400 uppercase tracking-wide">Gastos extras declarados</span>
                  <div class="bg-amber-50 border border-amber-100 rounded-xl px-4 py-3 flex flex-col gap-1">
                    <p class="font-semibold text-amber-800 text-sm">${gastosExtra.toLocaleString('es-AR')}</p>
                    {descGastos && <p class="text-xs text-amber-700">{descGastos}</p>}
                  </div>
                </div>
              )}
            </div>
          )}

        </div>

        <!-- Col derecha (1/3) -->
        <div class="flex flex-col gap-6">

          <!-- Cambiar estado -->
          <div class="bg-white rounded-2xl border border-cream-dark p-6 flex flex-col gap-4">
            <h2 class="font-serif font-bold text-[#1B4D2E] text-base">Estado del servicio</h2>
            <form method="POST" class="flex flex-col gap-3">
              <input type="hidden" name="accion" value="cambiar-estado" />
              <select
                name="estado"
                class="w-full border border-cream-dark rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-primary bg-white"
              >
                {(['pendiente','aceptada','en_curso','completada','cancelada'] as const).map(e => {
                  const requiereTecnico = ['aceptada','en_curso','completada'].includes(e)
                  const disabled = requiereTecnico && !sol.tecnico_id
                  return (
                    <option value={e} selected={sol.estado === e} disabled={disabled}>
                      {estadoLabel[e]}{disabled ? ' (requiere técnico)' : ''}
                    </option>
                  )
                })}
              </select>
              {!sol.tecnico_id && (
                <p class="text-xs text-amber-600">Asigná un técnico para poder avanzar el estado.</p>
              )}
              <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-semibold py-2.5 rounded-xl transition-colors text-sm">
                Actualizar estado
              </button>
            </form>
          </div>

          <!-- Desglose financiero -->
          <div class="bg-white rounded-2xl border border-cream-dark overflow-hidden">
            <div class="px-6 py-4 border-b border-cream">
              <h2 class="font-serif font-bold text-[#1B4D2E] text-base">Desglose financiero</h2>
            </div>

            {precioBase == null ? (
              <div class="px-6 py-5 text-sm text-gray-400 text-center">
                Tarifa a convenir — sin cálculo automático
              </div>
            ) : (
              <div class="px-6 py-5 flex flex-col gap-3 text-sm">
                <div class="flex justify-between text-gray-600">
                  <span>Precio base</span>
                  <span class="font-medium text-gray-800">{fmt(precioBase)}</span>
                </div>
                <div class="flex justify-between text-gray-600">
                  <span>Tasa plataforma ({tasa ?? 0}%)</span>
                  <span class="font-medium text-gray-800">
                    {gananciaPlataforma != null ? fmt(gananciaPlataforma) : '—'}
                  </span>
                </div>

                <div class="border-t border-cream pt-3 flex justify-between">
                  <span class="font-semibold text-gray-900">Total al cliente</span>
                  <span class="font-bold text-gray-900">{total != null ? fmt(total) : '—'}</span>
                </div>

                <!-- Desglose dueño -->
                <div class="bg-primary-soft rounded-xl p-4 flex flex-col gap-2 mt-1">
                  <p class="text-xs font-semibold text-[#1B4D2E] uppercase tracking-wide mb-1">Distribución</p>
                  <div class="flex justify-between text-[#1B4D2E]">
                    <span class="text-sm">Técnico recibe</span>
                    <span class="font-semibold">{fmt(cobrarAlTecnico!)}</span>
                  </div>
                  <div class="flex justify-between text-[#1B4D2E]">
                    <span class="text-sm font-bold">Plataforma retiene</span>
                    <span class="font-bold text-lg">{gananciaPlataforma != null ? fmt(gananciaPlataforma) : '—'}</span>
                  </div>
                </div>

                {sol.estado !== 'completada' && (
                  <p class="text-xs text-gray-400 text-center mt-1">
                    * Estimado — se confirma al completar el servicio
                  </p>
                )}
              </div>
            )}
          </div>

        </div>
      </div>

    </div>
  </div>
</Layout>
