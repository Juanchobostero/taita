---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar'
import { createSupabaseAdmin } from '../lib/supabase-admin'

const supabase = createSupabaseAdmin()
const { data: categoriasDB } = await supabase
  .from('categorias')
  .select('id, nombre, icono, imagen_url')
  .eq('activa', true)
  .order('nombre')

const categorias = categoriasDB ?? []
---

<Layout
  title="Todas las categorías — Taita Soluciones"
  description="Todos los servicios disponibles en Taita Soluciones"
>
  <Navbar client:load />

  <div class="bg-cream min-h-screen py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <a href="/" class="text-primary hover:text-primary-hover font-medium flex items-center gap-1 w-fit text-sm mb-6">
        ← Volver al inicio
      </a>

      <div class="mb-8">
        <h1 class="font-serif font-bold text-primary text-3xl mb-1">Todas las categorías</h1>
        <p class="text-gray-400 text-sm">Encontrá al experto adecuado para tu necesidad.</p>
      </div>

      {categorias.length === 0 ? (
        <p class="text-gray-400 text-sm text-center py-12">Todavía no hay categorías disponibles.</p>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
          {categorias.map(c => (
            <a
              href={`/solicitud?categoria=${c.id}`}
              class="bg-white rounded-2xl border border-[#D8D4CC] hover:border-primary-hover p-6 flex flex-col items-center gap-3 transition-colors group cursor-pointer"
            >
              <div class="w-14 h-14 rounded-xl overflow-hidden flex items-center justify-center bg-gray-100 shrink-0">
                {c.imagen_url
                  ? <img src={c.imagen_url} alt={c.nombre} class="w-full h-full object-cover" />
                  : <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                }
              </div>
              <span class="text-sm font-semibold text-gray-700 group-hover:text-primary transition-colors text-center">{c.nombre}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>

  <footer class="bg-[#111111] text-gray-400 py-10 px-4">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex flex-col items-center md:items-start gap-1">
        <div class="flex items-center gap-2">
          <span class="font-serif font-bold text-white text-lg">taita</span>
          <span class="text-primary-light text-sm font-medium">soluciones</span>
        </div>
        <p class="text-xs text-gray-600">Servicios técnicos a domicilio — Argentina</p>
      </div>
      <div class="flex gap-6 text-sm">
        <a href="/solicitud" class="hover:text-primary-light transition-colors">Solicitar servicio</a>
        <a href="/contacto" class="hover:text-primary-light transition-colors">Contacto</a>
        <a href="/reclamos" class="hover:text-primary-light transition-colors">Reclamos</a>
      </div>
    </div>
  </footer>
</Layout>
